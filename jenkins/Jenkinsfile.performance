// ─────────────────────────────────────────────────────────────────────────────
// Pipeline 3 — Performance Validation
//
// Covered tests
//   TCD-24  Lean Worker: benchmarks & concurrency load
//   TCD-25  Lean Worker: real-world Mathlib scenarios
//   Web API: HTTP response-time audit (min / avg / p95 / max, 20 req/endpoint)
//   Combined: Lean concurrent load, Redis / Celery throughput snapshot
//
// Artifacts archived to ${WORKSPACE}/perf-reports/ each run:
//   tcd24-benchmark.json        pytest-benchmark JSON (min/max/mean/stddev)
//   tcd24-junit.xml             JUnit XML → Jenkins "Tests" tab
//   tcd25-benchmark.json        pytest-benchmark JSON
//   tcd25-junit.xml             JUnit XML
//   web-api-timing.json         HTTP timing per endpoint (20 samples, p95)
//   lean-concurrent-load.json   throughput & wall-time per concurrency batch
//   celery-throughput.json      Redis round-trip latency + queue depths + workers
//   perf-summary.json           merged summary of all above
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        DC           = "docker compose -f /workspace/docker-compose.yml"
        PERF_REPORTS = "${WORKSPACE}/perf-reports"
    }

    stages {

        // ── Create artifact output directory ─────────────────────────────────
        stage('Setup') {
            steps {
                sh 'mkdir -p "$PERF_REPORTS"'
            }
        }

        // ── TCD-24: Lean Worker — Benchmarks & Concurrency Load ──────────────
        // pytest-benchmark writes tcd24-benchmark.json (min/max/mean/stddev per
        // test) and tcd24-junit.xml; both are copied to the Jenkins workspace
        // so archiveArtifacts and the junit step can pick them up.
        stage('TCD-24 · Lean Benchmarks & Load') {
            steps {
                sh '${DC} exec -T lean-worker mkdir -p /app/tests/tcd24_lean_performance'
                sh '${DC} cp /workspace/lean/tests/tcd24_lean_performance lean-worker:/app/tests/tcd24_lean_performance'
                sh '''${DC} exec -T lean-worker bash -c \
                    'pip3 install pytest-benchmark --quiet && \
                     cd /app && python3 -m pytest -v -s tests/tcd24_lean_performance/ \
                     --benchmark-sort=mean --benchmark-min-rounds=3 \
                     --benchmark-json=/tmp/tcd24-benchmark.json \
                     --junitxml=/tmp/tcd24-junit.xml || true' '''
                sh '${DC} cp lean-worker:/tmp/tcd24-benchmark.json "$PERF_REPORTS/tcd24-benchmark.json" || true'
                sh '${DC} cp lean-worker:/tmp/tcd24-junit.xml      "$PERF_REPORTS/tcd24-junit.xml"      || true'
            }
        }

        // ── TCD-25: Lean Worker — Real-World Mathlib Scenarios ───────────────
        stage('TCD-25 · Lean Mathlib Scenarios') {
            steps {
                sh '${DC} exec -T lean-worker mkdir -p /app/tests/tcd25_lean_realworld'
                sh '${DC} cp /workspace/lean/tests/tcd25_lean_realworld lean-worker:/app/tests/tcd25_lean_realworld'
                sh '''${DC} exec -T lean-worker bash -c \
                    'pip3 install pytest-benchmark --quiet && \
                     cd /app && python3 -m pytest -v -s tests/tcd25_lean_realworld/ \
                     --benchmark-sort=mean \
                     --benchmark-json=/tmp/tcd25-benchmark.json \
                     --junitxml=/tmp/tcd25-junit.xml || true' '''
                sh '${DC} cp lean-worker:/tmp/tcd25-benchmark.json "$PERF_REPORTS/tcd25-benchmark.json" || true'
                sh '${DC} cp lean-worker:/tmp/tcd25-junit.xml      "$PERF_REPORTS/tcd25-junit.xml"      || true'
            }
        }

        // ── Web API — HTTP Response Time Audit ───────────────────────────────
        // Runs from the Jenkins container (same Docker network as web/frontend).
        // Writes web-api-timing.json with min/avg/p95/max per endpoint.
        stage('Web API Response Time Audit') {
            steps {
                sh '''
python3 - <<'PYEOF'
import subprocess, json, statistics, os

out_dir = os.environ.get('PERF_REPORTS', '/tmp')
os.makedirs(out_dir, exist_ok=True)

def measure(label, url, count=20):
    times = []
    for _ in range(count):
        r = subprocess.run(
            ['curl', '-s', '-o', '/dev/null', '-w', '%{time_total}',
             '--max-time', '5', url],
            capture_output=True, text=True
        )
        try:
            times.append(float(r.stdout.strip()) * 1000)
        except ValueError:
            pass
    if not times:
        return {'label': label, 'url': url, 'count': 0, 'error': 'no_data'}
    s = sorted(times)
    return {
        'label':  label,
        'url':    url,
        'count':  len(times),
        'min_ms': round(min(times), 2),
        'avg_ms': round(statistics.mean(times), 2),
        'p95_ms': round(s[int(len(s) * 0.95)], 2),
        'max_ms': round(max(times), 2),
    }

endpoints = [
    ('GET /api/v1/auth/github/url', 'http://web:5000/api/v1/auth/github/url'),
    ('GET /api/v1/health',          'http://web:5000/api/v1/health'),
    ('GET / (frontend nginx)',      'http://frontend:80/'),
]

print('=== Web API Response Time Audit (20 req/endpoint) ===')
results = []
for label, url in endpoints:
    m = measure(label, url)
    results.append(m)
    if 'error' in m:
        print(f"  {label:<42}  ERROR: {m['error']}")
    else:
        print(
            f"  {label:<42}  "
            f"min={m['min_ms']}ms  avg={m['avg_ms']}ms  "
            f"p95={m['p95_ms']}ms  max={m['max_ms']}ms"
        )

out = os.path.join(out_dir, 'web-api-timing.json')
with open(out, 'w') as f:
    json.dump({'stage': 'web_api_timing', 'endpoints': results}, f, indent=2)
print(f'Artifact written: {out}')
PYEOF
'''
            }
        }

        // ── Combined Services — Concurrent Multi-Worker Load ─────────────────
        // Fires Lean verifications in concurrent batches (1/4/8 workers).
        // The Python script lives in jenkins/scripts/ and is copied into the
        // container as a file — avoiding Groovy \n-interpretation issues that
        // occur when Python source is passed via stdin heredoc.
        stage('Combined: Lean + Computation Concurrent Load') {
            steps {
                sh '${DC} cp /workspace/jenkins/scripts/lean-concurrent-load.py lean-worker:/tmp/lean-load.py'
                sh '${DC} exec -T lean-worker python3 /tmp/lean-load.py'
                sh '${DC} cp lean-worker:/tmp/lean-concurrent-load.json "$PERF_REPORTS/lean-concurrent-load.json" || true'
            }
        }

        // ── Combined Services — Web + Workers End-to-End Celery Throughput ───
        // Measures Redis round-trip latency (50 pings, p95), queue depths, and
        // worker registry. Script is copied as a file to avoid heredoc issues.
        stage('Combined: Web → Celery Pipeline Throughput') {
            steps {
                sh '${DC} cp /workspace/jenkins/scripts/celery-throughput.py web:/tmp/celery-throughput-script.py'
                sh '${DC} exec -T web python3 /tmp/celery-throughput-script.py'
                sh '${DC} cp web:/tmp/celery-throughput.json "$PERF_REPORTS/celery-throughput.json" || true'
            }
        }

        // ── Merge all JSONs → perf-summary.json + perf-report.txt ─────────────
        // 1. Stitches every *.json in perf-reports/ into perf-summary.json.
        // 2. Runs perf-report.py which reads the summary and writes a
        //    plain-English perf-report.txt (no machine details, human readable).
        stage('Collect: Build perf-summary.json + perf-report.txt') {
            steps {
                // Step 1 — merge JSONs into summary (runs in Jenkins container)
                sh '''
python3 - <<'PYEOF'
import json, os, glob, datetime

reports_dir = os.environ.get('PERF_REPORTS', '/tmp')
summary = {
    'build_timestamp': datetime.datetime.utcnow().isoformat() + 'Z',
    'reports': {},
}

for path in sorted(glob.glob(os.path.join(reports_dir, '*.json'))):
    name = os.path.basename(path).replace('.json', '')
    try:
        with open(path) as f:
            summary['reports'][name] = json.load(f)
        print('  merged: ' + name)
    except Exception as e:
        summary['reports'][name] = {'error': str(e)}
        print('  warning: ' + name + ': ' + str(e))

out = os.path.join(reports_dir, 'perf-summary.json')
with open(out, 'w') as f:
    json.dump(summary, f, indent=2)
print('Summary written: ' + out)
PYEOF
'''
                // Step 2 — generate plain-English report from summary
                sh 'python3 /workspace/jenkins/scripts/perf-report.py'
            }
        }

    } // stages

    post {
        always {
            // Publish JUnit XML results so they appear in the Jenkins Tests tab
            junit allowEmptyResults: true,
                  testResults: 'perf-reports/*-junit.xml'
            // Archive all JSON/XML artifacts — downloadable from the build page
            archiveArtifacts artifacts: 'perf-reports/**',
                             allowEmptyArchive: true,
                             fingerprint: true
            echo "Pipeline result: ${currentBuild.currentResult}"
        }
        success {
            echo "✔ Performance validation completed (${currentBuild.durationString.minus(' and counting')}). Artifacts in perf-reports/."
        }
        failure {
            echo "✘ Performance pipeline failed — check the logs above."
        }
    }
}
